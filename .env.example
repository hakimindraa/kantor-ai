# ==========================================
# Virtual AI Newsroom HQ - Environment Configuration
# ==========================================
# All variables are OPTIONAL. The app runs 100% out-of-the-box
# with full mock simulation if these are not provided.

# Database Connection (Postgres / Neon Pooler)
DATABASE_URL=""

# Base Site URLs
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_REAL_BACKEND_URL="http://localhost:3000"

# AI Model Configuration
GEMINI_MODEL="gemini-3.8-flash"
CLAUDE_MODEL="claude-3-7-sonnet"
GROQ_MODEL="llama-3.3-70b-versatile"

# Waterfall Queue Interval (in minutes)
WATERFALL_QUEUE_GAP_MINUTES="60"

