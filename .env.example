# ==========================================
# Virtual AI Newsroom HQ - Environment Configuration
# ==========================================
# All variables are OPTIONAL. The app runs 100% out-of-the-box
# with full zero-load simulation and webhook integration.

# Database Connection (Optional - leave empty for Zero-Load mode)
DATABASE_URL=""

# Secure Webhook Secret for receiving live events from AdaFakta Admin
KANTORAI_WEBHOOK_SECRET="your_secure_webhook_secret_here"

# Base Site URLs (Points to your live news portal AdaFakta & Bot Jurnalis)
NEXT_PUBLIC_SITE_URL="https://www.adafakta.web.id"
NEXT_PUBLIC_REAL_BACKEND_URL="https://www.adafakta.web.id"
NEXT_PUBLIC_BOTTELE_URL="https://bottelejurnalis.vercel.app"

# AI Model Configuration
GEMINI_MODEL="gemini-3.8-flash"
CLAUDE_MODEL="ag/claude-opus-4-6-thinking"
GROQ_MODEL="openai/gpt-oss-120b"

# Waterfall Queue Interval (in minutes)
WATERFALL_QUEUE_GAP_MINUTES="60"

